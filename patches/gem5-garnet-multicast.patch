+void
+NetworkInterface::traceMessage(const MsgPtr &msg_ptr, int vnet, int num_flits)
+{
+    PendingTrace &pt = m_pending_trace[vnet];
+    std::ostream &os = *m_net_ptr->traceStream();
+
+    // Pull the protocol message type ("Type = GETS") out of the SLICC
+    // generated print(); fall back to the message class name.
+    std::ostringstream ss;
+    msg_ptr->print(ss);
+    std::string desc = ss.str();
+    std::string type;
+    size_t pos = desc.find("Type = ");
+    if (pos != std::string::npos) {
+        pos += 7;
+        size_t end = desc.find_first_of(" ,]", pos);
+        type = desc.substr(pos, end - pos);
+    } else {
+        type = desc.substr(1, desc.find(':') - 1);
+    }
+
+    os << ticksToCycles(msg_ptr->getTime()) << ',' << pt.start << ','
+       << curCycle() << ',' << m_id << ',' << vnet << ','
+       << m_net_ptr->MessageSizeType_to_int(msg_ptr->getMessageSize())
+       << ',' << num_flits << ',' << type << ',' << pt.dests.size() << ',';
+    for (size_t i = 0; i < pt.dests.size(); i++)
+        os << (i ? ";" : "") << pt.dests[i];
+    os << ',';
+    for (size_t i = 0; i < pt.pkts.size(); i++)
+        os << (i ? ";" : "") << pt.pkts[i];
+    os << '\n';
+    pt.msg = nullptr;
+}
+
+void
+NetworkInterface::traceEject(flit *t_flit)
+{
+    if (std::ostream *os = m_net_ptr->ejectStream())
+        *os << t_flit->getPacketID() << ',' << curCycle() << ',' << m_id
+            << '\n';
+}
