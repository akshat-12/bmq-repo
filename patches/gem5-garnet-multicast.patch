+    // A multicast goes to every directory but the one on our own router:
+    // address bit 26 flags it, and the destination bits name our router.
+    // A router without a directory (more cores than directories, e.g. 36
+    // cores and 32 directories on a 6x6 mesh) sets bit 25 too: every
+    // directory. (Ruby XORs bits 20-23 into the directory choice, so avoid
+    // those.)
+    bool multicast = mcProb > 0 && rng->random<double>() < mcProb;
+    bool mc_all = multicast && id >= num_destinations;
+    if (multicast)
+        destination = mc_all ? 0 : id;
+
     // The source of the packets is a cache.
     // The destination of the packets is a directory.
     // The destination bits are embedded in the address after byte-offset.
     Addr paddr =  destination;
     paddr <<= blockSizeBits;
+    if (multicast)
+        paddr |= (Addr)1 << 26;
+    if (mc_all)
+        paddr |= (Addr)1 << 25;
+    // a rolling packet number in the bits between the destination and the
+    // hashed bits, so packets in flight never share a cache line (the
+    // sequencer holds back a second request to a busy line)
+    int dest_bits = (int) ceil(log2((double) num_destinations));
+    int seq_lo = blockSizeBits + dest_bits;
+    if (seq_lo < 20)
+        paddr |= ((Addr) numPacketsSent & ((1ULL << (20 - seq_lo)) - 1))
